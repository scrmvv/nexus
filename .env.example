# This is a standalone dashboard for your own VPS and site.
PORT=4317
VPS_LABEL=My VPS
SITE_LABEL=example.org
SITE_URL=https://example.org/

# Configure a separate access_log for your website in nginx.
# If this file is missing or unreadable, metrics still work, but no live traffic appears.
NGINX_ACCESS_LOG=/var/log/nginx/example.access.log

# Optional: actual VPS geo coordinates (NOT your home address).
# To keep locations accurate, both are empty by default.
SERVER_LAT=
SERVER_LON=

# Optional local City MMDB database (MaxMind GeoLite2 City or DB-IP City Lite).
# Requires mmdblookup from Ubuntu package mmdb-bin. No external IP API used.
# DB-IP Lite files named dbip*.mmdb receive automatic UI attribution.
GEOIP_MMDB=

# Optional Telegram alerts for scan bursts and site down / recovery.
# Create your bot using @BotFather and start a private chat with it first.
# NEVER commit the .env file to git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
ALERT_SCAN_THRESHOLD=3
