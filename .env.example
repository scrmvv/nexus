# This is a standalone dashboard for your own VPS and site.
PORT=4317
VPS_LABEL=My VPS
SITE_LABEL=scrmvv.space
SITE_URL=https://scrmvv.space/

# Configure a separate access_log for scrmvv.space in nginx.
# If this file is missing or unreadable, metrics still work, but no live traffic appears.
NGINX_ACCESS_LOG=/var/log/nexus/scrmvv.access.log

# Optional: actual VPS geo coordinates (NOT your home address).
# To keep locations accurate, both are empty by default.
SERVER_LAT=
SERVER_LON=

# Optional local MaxMind GeoLite2-City.mmdb or compatible city database.
# Requires mmdblookup from apt package libmaxminddb-bin. No external IP API used.
GEOIP_MMDB=
