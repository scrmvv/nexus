# EXAMPLE: edit User, Group, WorkingDirectory and ExecStart before installing.
[Unit]
Description=NEXUS infrastructure dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus
ExecStart=/usr/bin/node /opt/nexus/server/index.mjs
Restart=on-failure
RestartSec=4
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
CapabilityBoundingSet=
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
